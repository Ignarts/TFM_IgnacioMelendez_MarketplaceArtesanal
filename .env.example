# Copia este fichero a .env y rellena los valores antes de ejecutar docker compose

# Base de datos
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=marketplace
DB_ROOT_PASSWORD=root

# JWT — genera un secreto seguro de al menos 256 bits, por ejemplo:
# openssl rand -base64 64
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION_MS=86400000
